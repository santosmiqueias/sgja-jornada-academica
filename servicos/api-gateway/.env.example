# Copie para .env e preencha. NUNCA suba o .env para o GitHub (já está no .gitignore).
# Gere a senha do professor e os segredos com:  node gerar-hash.js "uma senha forte"

PORT=3000
# Endereços do site que podem chamar esta API (separados por vírgula)
ORIGENS_PERMITIDAS=http://localhost:5500,https://santosmiqueias.github.io
# Use 1 quando o servidor estiver atrás de Render, Railway ou Nginx (para o limite por IP funcionar)
TRUST_PROXY=

# ---- Segurança (obrigatório) ----
PROFESSOR_SENHA_HASH=
TOKEN_SEGREDO=
ASSINATURA_SEGREDO=
SESSAO_PROFESSOR_MIN=120
SESSAO_COMISSAO_MIN=240

# ---- Banco de dados ----
# Sem Base44, os dados ficam em arquivos na pasta dados/ deste servidor.
# Com Base44: crie as entidades com "npm run base44:push" (veja docs/base44.md) e preencha as duas linhas abaixo.
# BASE44_API_KEY: chave de API pessoal com acesso total (não use chave somente leitura)
BASE44_APP_ID=
BASE44_API_KEY=
# A cópia em memória dos dados é relida do Base44 a cada N segundos (padrão 60)
BASE44_CACHE_SEGUNDOS=60
DADOS_DIR=

# ---- Só para testes e apresentação (deixe false em produção) ----
ALLOW_DEMO=false
ALLOW_RESET=false

# ---- E-mail (sem SMTP, os envios ficam registrados como "simulado") ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_REMETENTE="Jornada Acadêmica UNINASSAU <seu-email@gmail.com>"

# ---- Lembretes por WhatsApp (30 min antes de cada atividade) ----
LEMBRETES_ATIVO=true
# simulado | meta | twilio
WHATSAPP_PROVEDOR=simulado
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=lembrete_atividade
WHATSAPP_IDIOMA=pt_BR
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
