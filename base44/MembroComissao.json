{
  "name": "MembroComissao",
  "type": "object",
  "properties": {
    "nome": {
      "type": "string"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "Único. Usado para entrar no check-in"
    },
    "cpf": {
      "type": "string",
      "description": "11 dígitos. Único"
    },
    "telefone": {
      "type": "string"
    },
    "senhaHash": {
      "type": "string",
      "description": "PBKDF2-SHA256 (100 mil repetições). A senha nunca é guardada"
    },
    "salt": {
      "type": "string",
      "description": "16 bytes aleatórios em hexadecimal"
    },
    "status": {
      "type": "string",
      "enum": [
        "pendente",
        "ativo",
        "bloqueado"
      ],
      "default": "pendente",
      "description": "Só 'ativo' registra check-in. Professor libera no painel"
    },
    "liberadoEm": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "nome",
    "email",
    "cpf",
    "senhaHash",
    "salt",
    "status"
  ]
}
