{
  "name": "Aluno",
  "type": "object",
  "properties": {
    "nome": { "type": "string", "description": "Nome completo (sai no certificado)" },
    "email": { "type": "string", "format": "email", "description": "Único na base" },
    "telefone": { "type": "string", "description": "Só dígitos, com DDD" },
    "cpf": { "type": "string", "description": "11 dígitos, sem máscara. Único na base" },
    "matricula": { "type": "string", "description": "6 a 12 dígitos. Única na base" },
    "curso": { "type": "string" },
    "periodo": { "type": "string" },
    "consentimentoLGPD": { "type": "boolean", "default": false },
    "aceitaWhatsApp": { "type": "boolean", "default": false, "description": "Autorizou lembretes por WhatsApp" },
    "atividades": { "type": "array", "items": { "type": "string" }, "description": "ids das atividades em que se inscreveu (EV01..EV06)" },
    "tokenIngresso": { "type": "string", "description": "Conteúdo assinado do QR Code" }
  },
  "required": ["nome", "email", "telefone", "cpf", "matricula", "curso", "atividades", "consentimentoLGPD"]
}
