    "alunoId": { "type": "string" },
    "eventoId": { "type": "string" },
    "telefone": { "type": "string" },
    "status": { "type": "string", "enum": ["enviado", "simulado", "falhou"] },
    "tentativas": { "type": "number" },
    "erro": { "type": "string" },
    "enviadoEm": { "type": "string", "format": "date-time" }
  },
