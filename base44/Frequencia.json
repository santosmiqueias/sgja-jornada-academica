{
  "name": "Frequencia",
  "type": "object",
  "properties": {
    "alunoId": {
      "type": "string",
      "description": "id do Aluno"
    },
    "eventoId": {
      "type": "string",
      "description": "id da atividade (EV01..EV06)"
    },
    "checkIn": {
      "type": "boolean",
      "default": true
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "origem": {
      "type": "string",
      "enum": [
        "lista",
        "qrcode",
        "cpf",
        "lote",
        "demo",
        "painel"
      ]
    },
    "registradoPorId": {
      "type": "string",
      "description": "id do MembroComissao que confirmou a presença"
    },
    "registradoPorNome": {
      "type": "string"
    }
  },
  "required": [
    "alunoId",
    "eventoId",
    "timestamp"
  ]
}
